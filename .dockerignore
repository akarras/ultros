# Build artifacts
/target
**/target

# Docker
Dockerfile
.dockerignore

# IMPORTANT: do NOT exclude /.git or the data/ game-data packs.
#   - `git-const::git_short_hash!()` is a proc-macro that reads .git at compile time
#     (ultros/src/main.rs, ultros-app/src/lib.rs, etc.)
#   - xiv-gen/build.rs runs `git rev-parse HEAD` to embed GIT_HASH
#   - the LFS-backed pack files under data/ (xiv-db, icons, manifest.toml) must
#     be present in the build context — they're COPYed into the image and
#     read by xiv-gen-db / ultros-xiv-icons at compile time

# Agent / editor state
/.claude
/.Jules
/.vscode
/.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Node / E2E (rebuilt inside the image if needed; large)
/integration/node_modules
/integration/screenshots
/integration/.cache

# Local env / secrets (defense in depth — never bake into images)
.env
.env.*
!.env.example

# Repo-level docs (not needed in the runtime image; build context only)
/README.md
/AGENTS.md
/CLAUDE.md
/docs
