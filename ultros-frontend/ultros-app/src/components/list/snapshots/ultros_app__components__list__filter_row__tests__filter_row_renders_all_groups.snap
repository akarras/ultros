<div data-testid="list-filter-row" class="panel rounded-lg p-3 flex flex-wrap items-center gap-x-6 gap-y-3"><div aria-label="Exclude Datacenters" class="flex flex-wrap items-center gap-2"><span class="text-xs font-semibold uppercase tracking-wide text-[color:var(--color-text-muted)]">Exclude</span><div class="flex flex-wrap gap-2"> <button type="button" data-datacenter="Aether" class="btn-secondary px-3 py-1 text-xs">Aether</button> <button type="button" data-datacenter="Primal" class="btn-secondary px-3 py-1 text-xs bg-red-950 text-red-200 border-red-400">Primal</button><!></div><label for="list-world-exclusion" class="sr-only">Exclude worlds</label><select id="list-world-exclusion" class="input h-9 min-w-40 py-1 text-sm"><option value="">Add world</option> <option value="100">Adamantoise</option><!></select><div class="flex flex-wrap items-center gap-1"> <button type="button" aria-label="Remove Behemoth world exclusion" class="inline-flex items-center gap-1 rounded-md border border-[color:var(--color-outline)] px-2 py-1 text-xs text-[color:var(--color-text)] hover:border-[color:var(--color-outline-strong)]"><span>Behemoth</span><svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" role="graphics-symbol"><g><path d="m16.192 6.344-4.243 4.242-4.242-4.242-1.414 1.414L10.535 12l-4.242 4.242 1.414 1.414 4.242-4.242 4.243 4.242 1.414-1.414L13.364 12l4.242-4.242z" /></g></svg></button><!><button type="button" class="btn-ghost px-2 py-1 text-xs">Clear</button></div></div><div class="flex flex-wrap items-center gap-2"><label for="list-sort-select" class="text-xs font-semibold uppercase tracking-wide text-[color:var(--color-text-muted)]">Sort</label><select id="list-sort-select" class="input h-9 py-1 text-sm"><option value="">Default order</option><option value="name">Name ↑</option><option value="name-desc">Name ↓</option><option value="price">Price ↑</option><option value="price-desc">Price ↓</option><option value="acquired">Acquired ↑</option><option value="acquired-desc">Acquired ↓</option></select></div><button type="button" class="btn-secondary px-3 py-1 text-xs">Hide acquired</button></div>
