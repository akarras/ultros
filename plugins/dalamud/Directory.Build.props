<Project>
  <PropertyGroup>
    <!-- One checked-in version for every managed assembly and release package. -->
    <UltrosPluginVersion>1.7.0.3</UltrosPluginVersion>
    <UltrosPluginReleaseNotes>Added the Live Crafting Copilot for Schema v2 crafting lists: interactive Craft checklist (Step order and By job grouping, Craft vs. Buy intermediate toggles, On-hand stock, ingredient readiness, and target/sub-craft completion buttons), one-click Sync bag stock from your character's loaded inventory, automatic live progression for in-game synths and material pickups, and recipe search / right-click Add recipe shortcuts alongside consolidated Shopping Route estimates.</UltrosPluginReleaseNotes>
    <Version>$(UltrosPluginVersion)</Version>
    <AssemblyVersion>$(UltrosPluginVersion)</AssemblyVersion>
    <FileVersion>$(UltrosPluginVersion)</FileVersion>
    <InformationalVersion>$(UltrosPluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
