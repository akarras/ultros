<Project>
  <PropertyGroup>
    <!-- One checked-in version for every managed assembly and release package. -->
    <UltrosPluginVersion>1.7.0.2</UltrosPluginVersion>
    <UltrosPluginReleaseNotes>Added Schema v2 crafting project support in the list document engine. Polished Market and Lists views with in-game item icons, resolved world names, HQ/NQ filters, sortable listings, auto-refreshed list estimates, and a world-grouped Shopping Route. Added Settings toggles for the summoning-bell shortcut and game-chat alert printing, one-click post-patch re-enable banners, tab unread badges, notification timestamps, and a 100% pure-managed WASM-to-IL list document engine (no native DLL).</UltrosPluginReleaseNotes>
    <Version>$(UltrosPluginVersion)</Version>
    <AssemblyVersion>$(UltrosPluginVersion)</AssemblyVersion>
    <FileVersion>$(UltrosPluginVersion)</FileVersion>
    <InformationalVersion>$(UltrosPluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
