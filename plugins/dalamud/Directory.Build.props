<Project>
  <PropertyGroup>
    <!-- One checked-in version for every managed assembly and release package. -->
    <UltrosPluginVersion>1.4.0.0</UltrosPluginVersion>
    <UltrosPluginReleaseNotes>Connect once with list editing and retainer syncing selected by default. Retainers save automatically at a summoning bell, and new characters upload private selling lists and price changes without extra setup. Existing upload pauses are preserved.</UltrosPluginReleaseNotes>
    <Version>$(UltrosPluginVersion)</Version>
    <AssemblyVersion>$(UltrosPluginVersion)</AssemblyVersion>
    <FileVersion>$(UltrosPluginVersion)</FileVersion>
    <InformationalVersion>$(UltrosPluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
