<Project>
  <PropertyGroup>
    <!-- One checked-in version for every managed assembly and release package. -->
    <UltrosPluginVersion>1.5.0.2</UltrosPluginVersion>
    <UltrosPluginReleaseNotes>Keep the familiar tabs, with uploaded listings grouped by retainer and clearer account permissions. Account details stay hidden until revealed. Delete notifications or clear this client's history. Fresh market responses keep complete listings current even when a confirmed price is unchanged.</UltrosPluginReleaseNotes>
    <Version>$(UltrosPluginVersion)</Version>
    <AssemblyVersion>$(UltrosPluginVersion)</AssemblyVersion>
    <FileVersion>$(UltrosPluginVersion)</FileVersion>
    <InformationalVersion>$(UltrosPluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
