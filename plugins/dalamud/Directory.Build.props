<Project>
  <PropertyGroup>
    <!-- One checked-in version for every managed assembly and release package. -->
    <UltrosPluginVersion>1.3.1.0</UltrosPluginVersion>
    <UltrosPluginReleaseNotes>Keep unsaved list progress when disconnecting or changing connections, and retry interrupted private retainer uploads without reopening Markets.</UltrosPluginReleaseNotes>
    <Version>$(UltrosPluginVersion)</Version>
    <AssemblyVersion>$(UltrosPluginVersion)</AssemblyVersion>
    <FileVersion>$(UltrosPluginVersion)</FileVersion>
    <InformationalVersion>$(UltrosPluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
