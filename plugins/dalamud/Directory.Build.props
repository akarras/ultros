<Project>
  <PropertyGroup>
    <!-- One checked-in version for every managed assembly and release package. -->
    <UltrosPluginVersion>1.2.0.0</UltrosPluginVersion>
    <UltrosPluginReleaseNotes>Optionally mark matching items acquired in the active list when they enter your inventory. Existing inventory and moves within bags or equipment do not count.</UltrosPluginReleaseNotes>
    <Version>$(UltrosPluginVersion)</Version>
    <AssemblyVersion>$(UltrosPluginVersion)</AssemblyVersion>
    <FileVersion>$(UltrosPluginVersion)</FileVersion>
    <InformationalVersion>$(UltrosPluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
