<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(UltrosLocalhostDebug)' == 'true'">
    <DefineConstants>$(DefineConstants);ULTROS_LOCALHOST_DEBUG</DefineConstants>
  </PropertyGroup>
</Project>
