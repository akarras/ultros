     use std::fmt;

+    #[test]
+    fn close_releases_pending_work_even_while_a_stream_retains_the_buffers() {
+        struct Probe(Arc<AtomicUsize>);
+        impl Drop for Probe {
+            fn drop(&mut self) {
+                self.0.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        let context = Arc::new(SsrSharedContext::new());
+        let weak = Arc::downgrade(&context);
+        let stream = context.pending_data().unwrap();
+        let dropped = Arc::new(AtomicUsize::new(0));
+        for closing in [false, true] {
+            if closing {
+                context.close();
+                context.close(); // Idempotent, including reentrant teardown.
+                assert_eq!(dropped.load(Ordering::SeqCst), 2);
+            }
+            let probe = Probe(dropped.clone());
+            let captured_context = context.clone();
+            context.write_async(
+                SerializedDataId::new(1),
+                Box::pin(async move {
+                    std::future::pending::<()>().await;
+                    drop((probe, captured_context));
+                    String::new()
+                }),
+            );
+            let probe = Probe(dropped.clone());
+            let captured_context = context.clone();
+            context.defer_stream(Box::pin(async move {
+                std::future::pending::<()>().await;
+                drop((probe, captured_context));
+            }));
+        }
+        assert_eq!(dropped.load(Ordering::SeqCst), 4);
+        drop(context);
+        assert!(weak.upgrade().is_none());
+        drop(stream);
+    }
