# Core Discord / OAuth configuration
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=your-discord-client-secret-here
HOSTNAME=http://localhost:8080
KEY=change-this-super-secret-cookie-key

# Database configuration
# For Postgres (production-style):
# DATABASE_URL=postgres://user:password@localhost/ultros
# Pool ceiling per instance (code default: 50). Budget it as
# (server max_connections - headroom) / instances you run at once - a stock
# Postgres allows 200, so several dev servers at once need this kept small or
# the next one to boot dies with "pool timed out while waiting for an open
# connection".
POSTGRES_MAX_CONNECTIONS=50
# Connections held open eagerly (code default: 10, clamped to the ceiling).
# Lower it when running several instances against one Postgres: the floor is
# claimed at startup whether or not you use it, and migrations need headroom
# on top, so a ceiling of 15 against the default floor of 10 will not boot.
# POSTGRES_MIN_CONNECTIONS=2

# Web server / logging
PORT=8080
RUST_LOG=ultros=info,warn

# Optional browser crash telemetry. GlitchTip DSNs work because it speaks the
# Sentry protocol.
# ULTROS_ERROR_REPORTING_DSN=https://public-key@glitchtip.example.com/1
# ULTROS_ERROR_REPORTING_ENVIRONMENT=development
# ULTROS_ERROR_REPORTING_SAMPLE_RATE=1.0
# ULTROS_ERROR_REPORTING_TRACES_SAMPLE_RATE=0.0
# ULTROS_ERROR_REPORTING_SDK_URL=https://browser.sentry-cdn.com/10.52.0/bundle.min.js

# Optional Leptos environment overrides
# LEPTOS_OUTPUT_NAME=ultros
# LEPTOS_ENVIRONMENT=development

# WebPush VAPID keys
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key

# Optional Glitchtip / Sentry error reporting (leave unset to disable)
# GLITCHTIP_DSN=https://<public_key>@glitchtip.example.com/<project_id>
# GLITCHTIP_SECURITY_REPORT_URL=https://glitchtip.example.com/api/<project_id>/security/?glitchtip_key=<public_key>
# Performance / transaction sampling for the backend. 0.0 disables
# (default — matches prior behavior); 1.0 sends every request as a
# transaction; pick something low like 0.05–0.1 in production.
# GLITCHTIP_TRACES_SAMPLE_RATE=0.1
# Tags transactions/errors so dev noise stays separate from prod.
# GLITCHTIP_ENVIRONMENT=development

# ClickHouse (analytics store; see docker-compose.dev.yml for local dev)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=ultros
CLICKHOUSE_USER=ultros
CLICKHOUSE_PASSWORD=ultros_dev

# QA/staging: skip subscribing to the Universalis market websocket. The ingest
# spawns a DB write per inbound event, so turning it off drops the write churn
# several replicas otherwise pile onto one shared Postgres. It does NOT cap
# connections - size POSTGRES_MAX_CONNECTIONS above for that; the default of 300
# per instance oversubscribes a stock 200-connection server on its own.
# Leave unset in production.
# ULTROS_DISABLE_UNIVERSALIS_WEBSOCKET=true
